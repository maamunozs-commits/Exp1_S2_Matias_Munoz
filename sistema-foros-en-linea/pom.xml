<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-parent</artifactId><version>3.5.16</version><relativePath/></parent>
    <groupId>cl.matiasmunoz</groupId><artifactId>foro-academico</artifactId><version>1.0.0</version><packaging>pom</packaging>
    <name>Foro académico de Matias Muñoz</name>
    <description>Sistema de foros en línea para Desarrollo Full Stack III DSY2205</description>
    <properties><java.version>21</java.version><project.build.sourceEncoding>UTF-8</project.build.sourceEncoding></properties>
    <modules><module>nucleo-comun</module><module>servicio-usuarios</module><module>servicio-foro</module></modules>
    <build>
        <testResources>
            <testResource><directory>src/test/resources</directory></testResource>
            <testResource>
                <directory>${project.basedir}/../../scripts/pruebas</directory>
                <includes><include>datos-${project.artifactId}.sql</include></includes>
            </testResource>
        </testResources>
        <plugins><plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><configuration><includes><include>**/Pruebas*.java</include></includes></configuration></plugin></plugins></build>
</project>
